# Server
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/findlocal

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS
FRONTEND_URL=http://localhost:4200

# Email (optional - logs to console in development)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@findtherapy.care
APP_URL=http://localhost:4200

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Sentry (error monitoring)
# Create projects at https://sentry.io — one for backend (Node.js), one for frontend (Angular)
SENTRY_DSN=

# PayFast (payment gateway)
# Create account at https://sandbox.payfast.co.za/ for testing
# IMPORTANT: Set up a passphrase in your PayFast account settings (Settings > Integration)
# The passphrase is required for secure signature generation
PAYFAST_MERCHANT_ID=12112194
PAYFAST_MERCHANT_KEY=ufpwccy0ytv6l
PAYFAST_PASSPHRASE=YourSecurePassphraseHere
